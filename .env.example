APP_ENV=production
APP_URL=https://example.com
APP_KEY=CHANGE_ME_USE_64_RANDOM_HEX_CHARACTERS
SESSION_SECURE=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanel_database_name
DB_USER=cpanel_database_user
DB_PASSWORD=CHANGE_ME

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2y$12$CHANGE_ME_WITH_A_REAL_PASSWORD_HASH

# Kuveyt Turk FreePos 3D Secure. Keep false until sandbox credentials are verified.
KUVEYT_TURK_ENABLED=false
KUVEYT_TURK_MODE=test
KUVEYT_TURK_CUSTOMER_ID=CHANGE_ME
KUVEYT_TURK_MERCHANT_ID=CHANGE_ME
KUVEYT_TURK_USERNAME=CHANGE_ME
KUVEYT_TURK_PASSWORD=CHANGE_ME
